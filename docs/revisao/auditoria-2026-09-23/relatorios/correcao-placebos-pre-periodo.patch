--- /dev/null
+++ b/tests/test_pretrend_window.py
@@ -0,0 +1,36 @@
+"""Placebos must be invariant to outcomes outside their pre-policy window."""
+import importlib.util
+import os
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import pytest
+
+
+@pytest.mark.parametrize("outside", ["before_start", "after_end"])
+def test_placebo_ignores_outcomes_outside_pre_window(tmp_path, outside):
+    default = Path(__file__).resolve().parents[1] / "scripts/estimate/10_spt_pretrend.py"
+    target = Path(os.environ.get("AUDIT_SPT_SCRIPT", str(default)))
+    spec = importlib.util.spec_from_file_location("spt_window_test", target)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    months = pd.period_range("2014-01", "2022-12", freq="M")
+    rows = [
+        (f"239{i:03d}", p.year, p.month, i / 11,
+         3200 + i + np.sin(k + i))
+        for i in range(12) for k, p in enumerate(months)
+    ]
+    panel = pd.DataFrame(rows, columns=["cod_ibge6", "ano", "mes", "dose", "peso_medio"])
+    altered = panel.copy()
+    mask = altered.ano.lt(2015) if outside == "before_start" else altered.ano.gt(2018)
+    altered.loc[mask, "peso_medio"] += 10000 * altered.loc[mask, "dose"]
+    results = []
+    for name, data in [("baseline", panel), ("altered", altered)]:
+        path = tmp_path / f"{name}.parquet"
+        data.to_parquet(path, index=False)
+        out = tmp_path / name
+        assert mod.main(["--painel", str(path), "--out-dir", str(out),
+                         "--n-boot", "20", "--inicio", "2015-01"]) == 0
+        results.append(pd.read_csv(out / "spt_pretrend__peso_medio.csv"))
+    pd.testing.assert_frame_equal(results[0], results[1])
